{
  "name": "lumio",
  "license": "GPL-3.0-only",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:android": "tsc -b && vite build --mode android && cap sync android",
    "build:desktop": "tsc -b && vite build --mode desktop --outDir electron/dist --emptyOutDir",
    "desktop": "pnpm build:desktop && electron electron",
    "dist:desktop": "pnpm build:desktop && electron-builder",
    "lint": "oxlint",
    "preview": "vite preview",
    "test:mixer": "node --test src/features/listen/mixer/tests/*.test.ts",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@capacitor/screen-orientation": "^8.0.2",
    "@capgo/capacitor-media-session": "^8.1.7",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource/archivo-black": "5.3.0",
    "@fontsource/figtree": "5.3.0",
    "@jellyfin/sdk": "^1.0.2",
    "@tabler/icons-react": "^3.50.0",
    "@tanstack/react-query": "^5.106.1",
    "axios": "^1.21.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "hls.js": "^1.7.4",
    "maplibre-gl": "6.15.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "signalsmith-stretch": "1.3.2",
    "sonner": "^2.0.8"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/cli": "^8.6.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "oxlint": "^1.90.0",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron"
    ],
    "overrides": {
      "minimatch@>=7 <11.0.1": "^11.0.5"
    },
    "patchedDependencies": {
      "signalsmith-stretch@1.3.2": "patches/signalsmith-stretch@1.3.2.patch"
    }
  }
}
