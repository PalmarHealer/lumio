# Lumio stem worker, NVIDIA GPU build (see worker.py): CUDA 12 + cuDNN 9 runtime as onnxruntime-gpu 1.20.2 needs
# (works with newer drivers too). Run with --gpus all (compose: device reservation) and PROVIDER=cuda; the model is
# mounted at /models/htdemucs.onnx, not part of the image.
FROM nvidia/cuda:12.4.1-cudnn-runtime-ubuntu22.04
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-pip libsndfile1 && rm -rf /var/lib/apt/lists/*
RUN pip3 install --no-cache-dir onnxruntime-gpu==1.20.2 numpy==2.1.3 soundfile==0.12.1
WORKDIR /app
COPY worker.py .
ENV PROVIDER=cuda
USER nobody
ENTRYPOINT []
CMD ["python3", "-u", "worker.py"]
